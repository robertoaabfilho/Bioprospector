# NCBI (opcional, deixa o PubMed/PubChem ~3x mais rápido). Chave gratuita:
# https://www.ncbi.nlm.nih.gov/account/ -> Account settings -> API Key
NCBI_API_KEY =

# OpenAlex (opcional, para a descoberta de plantas em artigos). Chave gratuita:
